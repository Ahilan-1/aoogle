# Flask session secret key (change this in production)
SECRET_KEY=aoogle-secure-session-key-change-in-production

# Admin panel password (change this)
ADMIN_PASSWORD=Admin@dummy123

# PostgreSQL is the sole mutable production datastore. data.json and the S3
# snapshots are migration/recovery inputs only; production never dual-writes
# user or billing state to JSON. Never commit a real connection string.
# On Railway, reference the private URL so you use private networking (no
# egress fees):  DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=
PERSISTENCE_BACKEND=postgres
# Generated during the Railway build from the checked-in static datasets.
SEARCH_INTELLIGENCE_DB=search_intelligence.sqlite3
# Optional: TLS mode for the Postgres connection (require | prefer | disable).
# Defaults to require. Leave unset unless you hit SSL issues on the private
# Railway endpoint (then use prefer).
# PGSSLMODE=

# Optional Railway S3-compatible bucket for compressed daily recovery snapshots
# and the persistent Flask session key. It is not the mutable database.
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
ENDPOINT=
REGION=auto

# Server port (default: 5000)
PORT=5000

# Amazon Associates tag (appended to product links for affiliate commission)
# Leave empty to skip affiliate tagging
AMAZON_ASSOCIATE_TAG=

# Groq API key for AI-powered search summaries
# Get one at https://console.groq.com
GROQ_API_KEY=
# Optional third Groq account, used only after the primary and backup accounts
# report a quota/capacity error. Never expose this client-side.
GROQ_API_KEY_3=
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
MCP_OAUTH_ISSUER=https://arlong.org
MCP_OAUTH_GOOGLE_REDIRECT_URI=https://arlong.org/oauth/google/callback

# Paddle keys for premium subscriptions
# Get API keys at https://vendors.paddle.com/authentication
PADDLE_LIVE_API_KEY=
PADDLE_SANDBOX_API_KEY=
# Create client-side token at Developers > Authentication > Client-side tokens
PADDLE_CLIENT_TOKEN=
# Copy from notification destination in Developer Tools > Notifications
PADDLE_WEBHOOK_SECRET=
# Set to 'live' or 'sandbox' (default: sandbox)
PADDLE_ENVIRONMENT=sandbox

# Resend API key for transactional emails
# Get one at https://resend.com
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Currents API key for news feed
# Get one at https://currentsapi.services
CURRENTS_API_KEY=

# AES-256-GCM encryption key for client-side encrypted search
# 64-character hex string (32 bytes). Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# If left empty, a random key is generated at startup (results lost on restart)
ENCRYPTION_KEY=

# Serper.dev API key for primary live-web retrieval and Places results.
# Get one at https://serper.dev
SERPER_API_KEY=

# Secondary Serper.dev key — rotated in when the primary key hits quota or fails.
SERPER_API_KEY_2=

# Purili is the secondary recovery index, consulted only when semantic coverage
# says the Serper primary set is incomplete or unavailable.
PURI_BASE_URL=https://puri.li
PURI_SEARCH_TIMEOUT=1.5

# Optional OpenAI-compatible embeddings API key. When set, neural_search uses
# real embeddings (e.g. text-embedding-3-small via OPENAI_API_KEY). When empty
# it falls back to a built-in local hashing embedding (zero config, offline).
EMBED_API_KEY=

# Google Maps Places API key (primary source for Places results; Serper is the fallback)
# Get one at https://console.cloud.google.com > APIs & Services > Library > Places API
GOOGLE_PLACES_API_KEY=

# WAQI (aqicn.org) API key for Air Quality Index panels
# Get one at https://aqicn.org/data-platform/token/
AQICN_API_KEY=

# Abstract API keys for holidays + currency exchange instant-answer panels
# Get them at https://www.abstractapi.com
ABSTRACT_HOLIDAYS_API_KEY=
ABSTRACT_EXCHANGE_API_KEY=
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_TEST_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_LIVE_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=live_mode
FOUNDER_SEAT_LIMIT=100
DODO_PAYMENTS_PRODUCT_ID_MONTHLY=
DODO_PAYMENTS_PRODUCT_ID_FOUNDER=
DODO_PAYMENTS_PRODUCT_ID_ANNUAL=
DODO_PAYMENTS_LIVE_PRODUCT_ID_MONTHLY=
DODO_PAYMENTS_LIVE_PRODUCT_ID_FOUNDER=
DODO_PAYMENTS_LIVE_PRODUCT_ID_ANNUAL=
# One-time, non-subscription products. The suffix is the granted credit amount.
DODO_PAYMENTS_PRODUCT_ID_CREDITS_100=
DODO_PAYMENTS_PRODUCT_ID_CREDITS_200=
DODO_PAYMENTS_PRODUCT_ID_CREDITS_300=
DODO_PAYMENTS_PRODUCT_ID_CREDITS_600=
DODO_PAYMENTS_PRODUCT_ID_CREDITS_1500=
DODO_PAYMENTS_PRODUCT_ID_CREDITS_3000=
DODO_PAYMENTS_PRODUCT_ID_CREDITS_6000=
DODO_PAYMENTS_LIVE_PRODUCT_ID_CREDITS_100=
DODO_PAYMENTS_LIVE_PRODUCT_ID_CREDITS_200=
DODO_PAYMENTS_LIVE_PRODUCT_ID_CREDITS_300=
DODO_PAYMENTS_LIVE_PRODUCT_ID_CREDITS_600=
DODO_PAYMENTS_LIVE_PRODUCT_ID_CREDITS_1500=
DODO_PAYMENTS_LIVE_PRODUCT_ID_CREDITS_3000=
DODO_PAYMENTS_LIVE_PRODUCT_ID_CREDITS_6000=
PUBLIC_BASE_URL=https://arlong.org

# Per-query provider cost used for internal search accounting.
SERPER_QUERY_COST_USD=
