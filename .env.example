# Flask session secret key (change this in production)
SECRET_KEY=aoogle-secure-session-key-change-in-production

# Admin panel password (change this)
ADMIN_PASSWORD=Admin@dummy123

# Railway Storage Bucket (S3-compatible) - for persistent data across deployments
# Leave empty to use local data.json file
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
ENDPOINT=
REGION=auto

# Server port (default: 5000)
PORT=5000

# Amazon Associates tag (appended to product links for affiliate commission)
# Leave empty to skip affiliate tagging
AMAZON_ASSOCIATE_TAG=

# Groq API key for AI-powered search summaries
# Get one at https://console.groq.com
GROQ_API_KEY=

# Paddle keys for premium subscriptions
# Get API keys at https://vendors.paddle.com/authentication
PADDLE_LIVE_API_KEY=
PADDLE_SANDBOX_API_KEY=
# Create client-side token at Developers > Authentication > Client-side tokens
PADDLE_CLIENT_TOKEN=
# Copy from notification destination in Developer Tools > Notifications
PADDLE_WEBHOOK_SECRET=
# Set to 'live' or 'sandbox' (default: sandbox)
PADDLE_ENVIRONMENT=sandbox

# Resend API key for transactional emails
# Get one at https://resend.com
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Currents API key for news feed
# Get one at https://currentsapi.services
CURRENTS_API_KEY=

# AES-256-GCM encryption key for client-side encrypted search
# 64-character hex string (32 bytes). Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# If left empty, a random key is generated at startup (results lost on restart)
ENCRYPTION_KEY=

# Serper.dev API key for "Places" local business results (near me / near <city>)
# Get one at https://serper.dev
SERPER_API_KEY=

# Google Maps Places API key (primary source for Places results; Serper is the fallback)
# Get one at https://console.cloud.google.com > APIs & Services > Library > Places API
GOOGLE_PLACES_API_KEY=
