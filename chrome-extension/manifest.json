{
  "manifest_version": 3,
  "name": "arlong Sidebar",
  "version": "1.2",
  "description": "arlong search engine sidebar with customizable fallback search",
  "permissions": [
    "storage",
    "tabs",
    "omnibox"
  ],
  "host_permissions": [
    "https://aoogle-production.up.railway.app/*",
    "http://localhost:5000/*",
    "https://www.google.com/*",
    "https://google.com/*",
    "https://www.bing.com/*",
    "https://bing.com/*",
    "https://duckduckgo.com/*",
    "https://search.yahoo.com/*",
    "https://yandex.com/*",
    "https://yandex.ru/*",
    "https://www.baidu.com/*",
    "https://baidu.com/*",
    "https://search.brave.com/*",
    "https://www.ecosia.org/*",
    "https://ecosia.org/*",
    "https://www.qwant.com/*",
    "https://qwant.com/*",
    "https://www.searx.be/*",
    "https://searx.be/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "arlong Sidebar",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://google.com/search*",
        "https://www.bing.com/search*",
        "https://bing.com/search*",
        "https://duckduckgo.com/*",
        "https://search.yahoo.com/search*",
        "https://yandex.com/search/*",
        "https://yandex.ru/search/*",
        "https://www.baidu.com/s*",
        "https://baidu.com/s*",
        "https://search.brave.com/search*",
        "https://www.ecosia.org/search*",
        "https://ecosia.org/search*",
        "https://www.qwant.com/*",
        "https://qwant.com/*",
        "https://www.searx.be/search*",
        "https://searx.be/search*"
      ],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "omnibox": {
    "keyword": "arl"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
