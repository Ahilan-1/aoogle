# Copy to benchmarks/.env.bench and fill in the keys you have.
# Engines without keys are skipped automatically.

# Arlong (local server). Point at your running instance.
ARLONG_BASE_URL=http://127.0.0.1:5000
# Uncomment if you hit a deployed instance that requires a token.
# ARLONG_API_KEY=

# Get at https://dashboard.exa.ai/api-keys  (free $20 credits)
EXA_API_KEY=

# Get at https://perplexity.ai/settings/api  (paid, ~$0.10 for this run)
PERPLEXITY_API_KEY=
# sonar | sonar-small | sonar-pro
PERPLEXITY_MODEL=sonar

# Get at https://platform.parallel.ai/home (free tier)
PARALLEL_API_KEY=

# Get at https://app.linkup.so (free $20 credit, no card)
LINKUP_API_KEY=

# Optional: used only by `report.py --judge`. Reuse the key already in the app .env.
GROQ_API_KEY=
# llama-3.3-70b-versatile | llama-3.1-8b-instant ...
JUDGE_MODEL=llama-3.3-70b-versatile
